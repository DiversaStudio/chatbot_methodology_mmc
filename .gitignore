# Local Claude Code settings
.claude/
.venv/
.superpowers/
.reports/

# Local entity-dictionary override. The tracked default is src/sami/entities.csv;
# anything dropped here wins locally and is deliberately not version controlled.
config/

# Author's local working folder: superseded by datasets/, never referenced by
# code or documentation, never version controlled.
data_&_docs/
docs/

# Python
__pycache__/
*.pyc
.venv/

# Secrets (pseudonymization salt)
.env

# Notebook execution cache
notebooks/cache/
*.bak

# graphify knowledge-graph output (regenerable)
graphify-out/

# Client deliverables and internal working documents, not repository artefacts:
# the executive report is distributed to MMC directly, and the dashboard user
# manual is an internal Diversa document. Neither travels with the code.
report/
USER_MANUAL.md

# Dataset intake: the folder structure and its docs are tracked, the data never
# is (the raw platform exports carry users' WhatsApp phone numbers).
datasets/**/*.xls
datasets/**/*.xlsx
datasets/**/*.xlsm
datasets/**/*.xlsb
datasets/**/*.ods
datasets/**/*.csv
!datasets/README.md
!datasets/**/.gitkeep
