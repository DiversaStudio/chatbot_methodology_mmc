# Local Claude Code settings
.claude/
.venv/
.superpowers/
.reports/

# Local entity-dictionary override. The tracked default is src/sami/entities.csv;
# anything dropped here wins locally and is deliberately not version controlled.
config/

# Author's local working folder: superseded by datasets/, never referenced by
# code or documentation, never version controlled.
data_&_docs/
docs/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Secrets (pseudonymization salt)
.env

# Notebook execution cache
notebooks/cache/
*.bak

# graphify knowledge-graph output (regenerable)
graphify-out/

# Client deliverables and internal working documents, not repository artefacts:
# the executive report is distributed to MMC directly, and the dashboard user
# manual is an internal Diversa document. Neither travels with the code.
report/
USER_MANUAL.md

# Message-level text extract for manual sentiment review, regenerated with
# `python review_messages.py`. Carries user messages (scrubbed by
# redact.scrub, unredactable rows dropped), so it must never enter version
# control -- the same reason message-grain `fact_message_full` was retired in
# schema v12. Wildcard, not ".xlsx": the reviewer may save it as .ods/.csv.
# Review artefacts (samples, agent pre-labels, hand-labelling sheets). They all
# carry user message text -- scrubbed, but never committable. Supersedes the
# earlier per-file rules.
exports/review/

# Spreadsheet lock files left behind while a workbook is open (LibreOffice
# .~lock.<name>#, Excel ~$<name>) -- never commit them.
.~lock.*#
~$*

# Dataset intake: the folder structure and its docs are tracked, the data never
# is (the raw platform exports carry users' WhatsApp phone numbers).
datasets/**/*.xls
datasets/**/*.xlsx
datasets/**/*.xlsm
datasets/**/*.xlsb
datasets/**/*.ods
datasets/**/*.csv
# LLM-labelling work files (scrubbed user text): batches, parquet, filled prompts
datasets/labels/llm_haiku*/
!datasets/README.md
!datasets/**/.gitkeep
