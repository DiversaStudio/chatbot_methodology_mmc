# Local Claude Code settings
.claude/
.venv/
.superpowers/

# Author's local working folder: superseded by datasets/, never referenced by
# code or documentation, never version controlled.
data_&_docs/

# Python
__pycache__/
*.pyc
.venv/

# Secrets (pseudonymization salt)
.env

# Notebook execution cache
notebooks/cache/
*.bak

# graphify knowledge-graph output (regenerable)
graphify-out/

# Dataset intake: the folder structure and its docs are tracked, the data never
# is (the raw platform exports carry users' WhatsApp phone numbers).
datasets/**/*.xls
datasets/**/*.xlsx
datasets/**/*.xlsm
datasets/**/*.csv
!datasets/README.md
!datasets/**/.gitkeep
